# Compose-level variables (variable substitution in docker-compose.yml).
# Copy to .env at the repo root. Keep POSTGRES_* in sync with DATABASE_URL in
# ai-harvest-agent/.env.
POSTGRES_DB=harvest_db
POSTGRES_USER=harvest
POSTGRES_PASSWORD=change-me

# Host binding for PostgreSQL port 5432. Unset -> 127.0.0.1 (loopback only) —
# the correct value for EC2; use an SSH tunnel for remote analysis and never
# expose 5432 publicly.
# Local dev on Windows/WSL2 only: set 0.0.0.0 — Windows->WSL localhost
# forwarding is unreliable for loopback-bound ports (WSL subnet stays NAT'd
# behind the Windows firewall, so this is still not LAN-exposed).
# POSTGRES_BIND_IP=127.0.0.1
# POSTGRES_HOST_PORT=5432

# Host binding for the api container's published ports (8000 = FastAPI,
# 6080 = noVNC live browser view). Unset -> 127.0.0.1. Same WSL2 note as
# above applies for local dev on Windows.
# API_BIND_IP=127.0.0.1
