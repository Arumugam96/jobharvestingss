# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=AI Harvest Agent
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-32-chars-min
API_KEY=your-api-key-here    # clients must send X-API-Key: <value>
PUBLIC_BASE_URL=
# Outreach open/click tracking (Mailjet). false keeps mail out of Gmail's Promotions
# tab; true re-enables open/click analytics. Delivery/bounce/unsub events fire either way.
OUTREACH_TRACK_ENGAGEMENT=false
# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://harvest:harvest_password@localhost:5432/harvest_db

# PostgreSQL container credentials — read by docker-compose for the postgres
# service. Keep in sync with DATABASE_URL above.
POSTGRES_DB=harvest_db
POSTGRES_USER=harvest
POSTGRES_PASSWORD=harvest_password
# Host binding for port 5432. 127.0.0.1 (default) keeps the DB reachable from
# the machine itself only — correct for both local dev and EC2 (use an SSH
# tunnel from your laptop for EC2 analysis; never set this to 0.0.0.0 on EC2).
# POSTGRES_BIND_IP=127.0.0.1
# POSTGRES_HOST_PORT=5432

# Source database for scripts/migrate_sqlite_to_postgres.py (read-only source;
# the script never modifies it).
SQLITE_DATABASE_PATH=./data/harvest.db

# Where GET /harvest-status, /run-history, /{linkedin,naukri,dice}-results read
# from: "auto" (DB first, JSON-file fallback if empty/unreachable — default),
# "database" (DB only), or "json" (JSON/file store only, skip the DB read).
# Writes always go to both regardless of this setting.
DATA_SOURCE=auto

# ── Auth / OTP email login ────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN=sightspectrum.com
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── SMTP (login OTPs + harvest report emails — see harvest_config.json "notifications") ───────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@sightspectrum.com
SMTP_USE_TLS=true
# Socket timeout for the whole SMTP exchange, incl. the DATA write. Bump it if
# large emails time out (kept as a safety ceiling).
SMTP_TIMEOUT_SECONDS=60

# ── Outreach ────────────────────────────────────────────────────────────────
# Public URL of the hosted corporate-overview deck. When set, outreach emails
# include a clickable link to it (fast send); when empty, no deck link and no
# attachment. Upload the deck to a public location and paste the share URL here.
OUTREACH_DECK_URL=
# Automated end-of-harvest outreach. When true (default), each completed harvest run
# auto-sends an initial outreach email to every harvested recruiter that has an email
# and logs it to the Mail-logs table. Skips suppressed/unsubscribed/already-contacted
# recruiters (idempotent). Set false to disable.
OUTREACH_AUTO_SEND_ON_HARVEST=true
# Reply-To for those unattended auto-sends (no logged-in salesperson). Visible From
# stays the shared harvest-agent identity; replies go here and it's recorded as the
# send's sent_by. Falls back to SMTP_FROM_EMAIL when empty.
# Accepts a comma-separated list: with TWO OR MORE addresses the primary Reply-To
# rotates one per calendar day (day 1 → first address, day 2 → second, then wraps),
# so recruiter replies alternate between salespeople day by day. The sign-off reach-out
# line in the email body rotates to match the same day's address. "Day 1" is anchored
# to the first automated send (stored in data/config/reply_to_rotation.json). Any
# OUTREACH_EXTRA_REPLY_TO addresses below are still attached on top on every send —
# so for strict one-owner-per-day, keep the rotating people HERE and leave EXTRA empty.
OUTREACH_AUTO_REPLY_TO=
# Comma-separated EXTRA Reply-To addresses added to outreach emails alongside the
# salesperson's own address. NOT recipients of our sends — they only receive the
# recruiter's REPLY (their mail client addresses every Reply-To on Reply), so the
# whole desk sees the response. Empty = none.
OUTREACH_EXTRA_REPLY_TO=

# ── Reply tracking (capturing prospect replies to our outreach) ───────────────
# How inbound replies reach the app. Both paths funnel into the SAME capture
# pipeline (match → store → stamp replied_at → forward to the alert mailbox); only
# the ingestion SOURCE differs:
#   brevo → Brevo inbound-parse POSTs to /outreach/inbound-reply. Needs a dedicated
#           inbound MX record pointed at Brevo (the legacy default).
#   imap  → poll the reply mailbox over IMAP on a timer. NO DNS/MX change needed —
#           it reads a mailbox you already own. Use for Zoho / Google Workspace /
#           cPanel mailboxes (which allow app-password IMAP). NOT Microsoft 365.
#   graph → poll a Microsoft 365 mailbox via the Microsoft Graph API (app-only
#           OAuth2). Required for M365, which blocks password/app-password IMAP.
#           NO DNS/MX change. Uses the GRAPH_* block below.
#   off   → replies are not captured.
REPLY_TRACKING_MODE=brevo

# ── IMAP reply mailbox (used ONLY when REPLY_TRACKING_MODE=imap) ───────────────
# The mailbox replies land in — i.e. the outreach From / Reply-To address. This is a
# mailbox on YOUR mail provider (Google Workspace, Zoho, M365, cPanel…), NOT Brevo —
# Brevo only relays outbound. IMAP over TLS (993) is included free with every such
# mailbox.
IMAP_HOST=                      # e.g. imap.gmail.com | imappro.zoho.com | outlook.office365.com
IMAP_PORT=993
IMAP_USERNAME=                  # the reply mailbox address, e.g. outreach@sightspectrum.com
# Mailbox password OR an app-specific password. Google Workspace / M365 with MFA
# require an APP PASSWORD (or OAuth), not the normal login password; Zoho / cPanel
# usually accept the mailbox password directly. See the README for per-provider steps.
IMAP_PASSWORD=
IMAP_USE_SSL=true               # true → implicit TLS on 993 (standard). false → STARTTLS on 143.
IMAP_MAILBOX=INBOX              # folder to scan; point at a dedicated "Replies" folder if a filter files them there
IMAP_POLL_INTERVAL_SECONDS=180  # how often to check (120–300s is plenty)
IMAP_MAX_MESSAGES_PER_POLL=50   # safety cap per poll; a larger backlog is drained over successive polls

# ── Microsoft Graph reply mailbox (used ONLY when REPLY_TRACKING_MODE=graph) ───
# App-only OAuth2 against Microsoft 365. One-time Entra ID (Azure AD) setup, done by
# a tenant admin:
#   1. Entra admin center → App registrations → New registration (single tenant).
#      Copy the "Application (client) ID" and "Directory (tenant) ID".
#   2. Certificates & secrets → New client secret → copy its VALUE (not the id).
#   3. API permissions → Add → Microsoft Graph → APPLICATION permissions → "Mail.Read"
#      → then "Grant admin consent".
#   4. Lock it to ONLY the reply mailbox (so the app can't read the whole org), in
#      Exchange Online PowerShell:
#        New-ApplicationAccessPolicy -AppId <client-id> `
#          -PolicyScopeGroupId <a mail-enabled security group containing the mailbox> `
#          -AccessRight RestrictAccess -Description "Reply poller: reply mailbox only"
GRAPH_TENANT_ID=                # Entra "Directory (tenant) ID"
GRAPH_CLIENT_ID=                # Entra "Application (client) ID"
GRAPH_CLIENT_SECRET=            # the client secret VALUE from step 2
GRAPH_MAILBOX=ananyamehta@sightspectrum.com   # the OUTREACH_AUTO_REPLY_TO / Reply-To mailbox to read
GRAPH_MAILBOX_FOLDER=inbox      # folder to read; a dedicated "Replies" folder's id also works
GRAPH_POLL_INTERVAL_SECONDS=180
GRAPH_MAX_MESSAGES_PER_POLL=50

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=8096

# ── LLM provider (governs ALL LLM usage: HTML extraction AND text/JSON
#    generation — recruiter outreach email/LinkedIn, harvest planning, etc.) ───
# ""/"claude"/"claude-*"          -> Anthropic Claude.
# "ollama"                        -> local Ollama server (LOCAL_LLM_URL), model = LOCAL_LLM_MODEL.
# "openrouter"                    -> OpenRouter, model = OPENROUTER_MODEL.
# "openrouter/<provider>/<model>" -> OpenRouter, using that model id directly.
# any other value (e.g. "llama3.1:8b") -> routed to the local Ollama server instead.
EXTRACTION_LLM_MODEL=claude
# Single failover provider tried when the primary above is down (same value
# format, e.g. "claude" or "openrouter"). Empty = no failover; the harvest then
# degrades and stores un-enriched jobs for re-enrichment on a later run.

LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1:8b
EXTRACTION_FALLBACK_MODEL=
REENRICHMENT_MAX_AGE_DAYS=7
REENRICHMENT_SWEEP_LIMIT=50

# ── OpenRouter (fallback LLM for HTML extraction) ─────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza-your-key-here
GEMINI_MODEL=gemini-2.0-flash

# ── Apollo.io (contact enrichment fallback) ───────────────────────────────────
# Last-resort tier: when the LLM/regex LinkedIn extraction finds no email, look the
# person up on Apollo by their LinkedIn URL. Get the key from the Apollo dashboard →
# Settings → API Keys. Leave APOLLO_API_KEY empty to disable Apollo entirely.
# APOLLO_REVEAL_PHONE: phone reveal is credit-heavy AND delivered asynchronously via
# a webhook, so phones won't resolve synchronously. Apollo REQUIRES APOLLO_WEBHOOK_URL
# when reveal is on — without it the whole request 400s (email included), so phone
# reveal is auto-downgraded to email-only until you set a receiver URL below.
# APOLLO_RECHECK_DAYS: per-profile cooldown so the same person isn't re-sent every run.
# APOLLO_WEBHOOK_URL: full public URL of the phone receiver — Apollo POSTs revealed
# phones there minutes after the reveal, e.g.
#   http://<public-host>:8080/recruiter-finder/apollo-phone-webhook
# (Apollo's docs ask for public HTTPS; if it rejects an http URL the reveal is retried
# email-only and the log shows apollo_webhook_url_rejected.) Setting it enables the
# Phone / Both reveal on the /contacts page.
# APOLLO_WEBHOOK_TOKEN: shared secret appended to that URL as ?token=… (Apollo doesn't
# sign its webhook) — deliveries with a wrong token are logged and rejected 401.
# APOLLO_PHONE_PENDING_TTL_MINUTES: a phone request with no delivery after this long is
# marked NOT_FOUND (a late delivery still lands and is charged).
APOLLO_API_KEY=
APOLLO_REVEAL_PHONE=false
APOLLO_WEBHOOK_URL=
APOLLO_WEBHOOK_TOKEN=
APOLLO_PHONE_PENDING_TTL_MINUTES=60
APOLLO_RECHECK_DAYS=30

# ── Recruiter Contact Finder (/contacts page) ─────────────────────────────────
# Its own Apollo credit bucket, SEPARATE from the harvest's APOLLO_DAILY_CAP and
# scoped per tenant/workspace per UTC day (0 = unlimited). A tenant can override
# this in its tenants.config JSON ("recruiter_finder_daily_cap").
RECRUITER_FINDER_DAILY_CAP=50
# Finder credits per phone, charged only when Apollo's webhook delivers a number
# (an email is 1 credit, charged on a hit).
RECRUITER_FINDER_PHONE_CREDIT_COST=8
RECRUITER_FINDER_MAX_ROWS=1000
RECRUITER_FINDER_CONCURRENCY=3

# ── LinkedIn Scraper ──────────────────────────────────────────────────────────
# NOTE: No login credentials needed. Users log in manually to Chrome first.
# The agent reuses the persistent Chrome profile at data/chrome_profile/
LINKEDIN_SCRAPER_SLOW_MO_MS=600       # ms between Playwright actions (anti-bot)
LINKEDIN_DESCRIPTION_CONCURRENCY=3   # parallel detail-page tabs
LINKEDIN_HEADLESS=true
# Optional — only used for SSO-based accounts
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
MICROSOFT_EMAIL=
MICROSOFT_PASSWORD=

# ── LinkedIn profile-visit anti-detection ─────────────────────────────────────
# Human-like randomized pause (ms) BETWEEN recruiter /in/ profile visits during
# the post-harvest contact-discovery pass (and between prospect lookups).
# Back-to-back profile opens are a strong bot signal.
LINKEDIN_PROFILE_VISIT_DELAY_MIN_MS=8000
LINKEDIN_PROFILE_VISIT_DELAY_MAX_MS=25000
# Max NEW recruiter /in/ profile pages opened per harvest run. Already-visited
# recruiters are never re-opened, so this only bounds first-time visits.
LINKEDIN_RECRUITER_VISIT_CAP=25
# Master switch for the manual Prospect Intelligence tool
# (POST /run-prospect-intelligence). Off by default — it visits /in/ profiles.
PROSPECT_INTELLIGENCE_ENABLED=false

# ── LinkedIn Home Feed lead harvest ───────────────────────────────────────────
# Scrapes the authenticated Home Feed (/feed/) — NOT the Jobs board — and turns
# genuine IT hiring posts into leads. All stop conditions are tunable here.
LINKEDIN_FEED_MAX_POSTS=80              # max posts to inspect, then stop
LINKEDIN_FEED_MAX_SCROLLS=40           # max scroll actions, then stop
LINKEDIN_FEED_SCROLL_DELAY_MS=2500     # pause between scrolls (lets the feed lazy-load)
LINKEDIN_FEED_MIN_SCROLLS=10           # always scroll at least this many times before the no-new stop
LINKEDIN_FEED_NO_NEW_STOP_ROUNDS=3     # stop after N scrolls with no new (non-dup) posts
LINKEDIN_FEED_EMPTY_DOM_STOP_ROUNDS=2  # stop after N scrolls returning an empty feed DOM
LINKEDIN_FEED_LLM_MAX_CALLS=300        # per-run cap on classify+extract LLM calls
LINKEDIN_FEED_MIN_CONFIDENCE=0.6       # min classifier confidence to accept a lead
# Testing-only cap on the number of LinkedIn jobs harvested per run, regardless
# of the max_jobs configured in harvest_config.json. Leave unset/blank to
# harvest normally (no cap beyond max_jobs).
# LINKEDIN_TEST_MAX_JOBS=5

# ── Sales Navigator (standalone experimental script) ──────────────────────────
# Dynamic per-day budget for scripts/scrape_sales_navigator.py — tunable here
# without code changes (NOT derived from MAX_JOBS_PER_DAY). Both UTC-day scoped.
#   SALES_NAVIGATOR_MAX_JOBS_PER_DAY   this script's own per-day cap (0 = disabled/skip)
#   SALES_NAVIGATOR_DAILY_STOP_CEILING stop once today's total scraped jobs reach this (0 = no ceiling)
SALES_NAVIGATOR_MAX_JOBS_PER_DAY=0
SALES_NAVIGATOR_DAILY_STOP_CEILING=0

# ── Naukri Scraper ────────────────────────────────────────────────────────────
# NOTE: shared / isolated modes harvest as a guest (no login). recruiter mode
# needs a one-time HUMAN login (see NAUKRI_BROWSER_MODE below) — credentials are
# never typed by the app, so NAUKRI_EMAIL / NAUKRI_PASSWORD are not used for it.
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
# Where the Naukri browser runs:
#   shared    (default) LinkedIn and Naukri run as two concurrent tabs in ONE
#             browser: the run's persistent Chrome profile on full bundled
#             Chromium, so both tabs show in the Live Browser view.
#   isolated  own cookie-less guest browser, independent of any LinkedIn profile
#             (e.g. a Naukri-only worker or a host without the LinkedIn profile).
#   recruiter own browser on the logged-in Naukri RECRUITER profile
#             (NAUKRI_RECRUITER_PROFILE_DIR): www.naukri.com job pages are browsed
#             with the recruiter session cookies. Connect it once via Connect in
#             the Rule Engine (or POST /naukri-recruiter/login) and log in yourself
#             in the Live Browser. Each run checks the session first; an expired
#             session fails ONLY the Naukri source — it never falls back to guest.
# NAUKRI_BROWSER_MODE=shared
# NAUKRI_BROWSER_MODE=recruiter
# NAUKRI_RECRUITER_PROFILE_DIR=data/naukri_recruiter_profile
# How Connect signs the recruiter in. Naukri now requires its Launcher app for
# recruiter login: put the Linux build (naukri.com/recruit/login/app/s/7/111/
# linux/x64/naukri-launcher.AppImage) at NAUKRI_LAUNCHER_APPIMAGE and Connect runs
# it in the Live Browser; log in inside the Launcher. auto = launcher when the
# AppImage is present (Linux), else the old browser login. auto|launcher|browser
# NAUKRI_RECRUITER_LOGIN_MODE=auto
# NAUKRI_LAUNCHER_APPIMAGE=data/naukri_launcher/naukri-launcher.AppImage

# ── Resdex candidate matching ────────────────────────────────────────────────
# Before automatic outreach, each recruiter/job-posting-email job (LinkedIn /
# Naukri) gets a Naukri Resdex search with the connected recruiter session:
# JD → LLM requirements → Boolean query + filters → 2-3 candidates, stored and
# shown on the job detail page (with Resdex links + the outreach email).
# Start in shadow mode (ENABLED=true, INCLUDE_IN_EMAIL=false), review matches on
# the job detail page, then add the anonymised candidate card to emails.
# RESDEX_ENABLED=false
# RESDEX_INCLUDE_IN_EMAIL=false
# RESDEX_SOURCES=LinkedIn,Naukri
# Also search for jobs whose only contact is the Apollo company HR contact
# (no recruiter/job-posting email) — more profiles to review while testing.
# RESDEX_INCLUDE_COMPANY_CONTACTS=false
# Also search for jobs with NO email at all — candidates stored for the job detail
# page only (never emailed: no recipient). Handy while testing.
# RESDEX_INCLUDE_JOBS_WITHOUT_EMAIL=false
# RESDEX_CANDIDATES_PER_JOB=3
# RESDEX_MIN_SKILL_COVERAGE=0.6
# RESDEX_ACTIVE_WITHIN_MONTHS=3
# RESDEX_MAX_SEARCHES_PER_JOB=3
# Opening full profiles spends Resdex view credits — off by default.
# RESDEX_OPEN_PROFILES=false
# Hard daily caps (account-wide, DB-enforced, fail closed; 0 = unlimited).
# RESDEX_DAILY_SEARCH_CAP=100
# RESDEX_DAILY_CANDIDATE_CAP=100
# RESDEX_REUSE_DAYS=14
# RESDEX_DELAY_MIN_MS=20000
# RESDEX_DELAY_MAX_MS=45000
# After results load: scroll the list + dwell a random total (seconds) — never
# clicks a candidate.
# RESDEX_RESULTS_DWELL_MIN_S=5
# RESDEX_RESULTS_DWELL_MAX_S=15
# Every N searches in a batch, an extra random break (seconds) on top of the
# normal gap; 0 = never. Interruptible by a harvest stop.
# RESDEX_BREAK_EVERY_SEARCHES=10
# RESDEX_BREAK_MIN_S=120
# RESDEX_BREAK_MAX_S=240
# CAPTCHA / block during a batch: wait up to this long (seconds) for a human to
# solve it in the Live Browser (never solved automatically); unsolved → the
# remaining jobs are marked error.
# RESDEX_HUMAN_WAIT_S=600
# RESDEX_LLM_TIMEOUT_S=45
# RESDEX_LLM_MODEL=
# Per-job detail pass (full description, employment type, work mode, company site).
# NAUKRI_FETCH_DETAILS=true
# Human-like randomized gap between consecutive detail-page visits (~45 s avg).
# The adaptive governor multiplies it after each CAPTCHA/block (up to
# NAUKRI_BACKOFF_MAX_MULTIPLIER) and eases back one step after
# NAUKRI_BACKOFF_CLEAN_STREAK clean detail pages.
# NAUKRI_DETAIL_DELAY_MIN_MS=30000
# NAUKRI_DETAIL_DELAY_MAX_MS=60000
# NAUKRI_BACKOFF_MAX_MULTIPLIER=4.0
# NAUKRI_BACKOFF_CLEAN_STREAK=10
# A longer "coffee break" every N detail pages (0 = never).
# NAUKRI_BREAK_EVERY_DETAILS=18
# NAUKRI_BREAK_MIN_S=180
# NAUKRI_BREAK_MAX_S=300
# On a blocked detail page: cool down, then retry that job once.
# NAUKRI_BLOCK_COOLDOWN_MIN_S=120
# NAUKRI_BLOCK_COOLDOWN_MAX_S=300
# Circuit breaker: after N consecutive blocks pause the detail pass, then probe one.
# NAUKRI_BREAKER_THRESHOLD=3
# NAUKRI_BREAKER_PAUSE_MIN_S=600
# NAUKRI_BREAKER_PAUSE_MAX_S=900
# Human-in-the-loop: when blocks persist on a MANUAL run in a HEADED browser,
# wait up to this long for someone to solve the CAPTCHA in the Live Browser
# (0 = never wait; scheduled / headless runs never wait).
# NAUKRI_HUMAN_WAIT_S=600
# LLM enrichment on top of the deterministic parse, via the EXTRACTION_LLM_MODEL
# chain (skipped with one warning when no provider is configured):
#   contact extraction — recruiter name/designation/company/emails/phones, only
#     for descriptions with a contact signal (@, [at], mailto, phone-like digits,
#     "contact"/"email"/"call"/"send your CV"...). Every value is verified against
#     the description text; anything not written there is dropped.
#   restructure — only for flat, run-on descriptions; kept only if no word changed.
# Calls run in the background alongside the detail visits (bounded by the
# timeout, concurrency, a per-run cap and a failure circuit breaker).
# NAUKRI_LLM_CONTACT_EXTRACTION=true
# NAUKRI_LLM_DESCRIPTION_RESTRUCTURE=true
# NAUKRI_LLM_TIMEOUT_S=45
# NAUKRI_LLM_CONCURRENCY=2
# NAUKRI_LLM_MAX_CALLS_PER_RUN=1000
# Provider for this pass only (empty = inherit EXTRACTION_LLM_MODEL /
# EXTRACTION_FALLBACK_MODEL). Recommended for accuracy: a Claude model.
# NAUKRI_LLM_MODEL=claude
# NAUKRI_LLM_FALLBACK_MODEL=ollama
# Testing-only cap on Naukri jobs per run (overrides max_jobs when lower).
# NAUKRI_TEST_MAX_JOBS=5

# ── Dice Scraper ──────────────────────────────────────────────────────────────
# Dice is a public job board — no login required for standard scraping
DICE_EMAIL=
DICE_PASSWORD=

# ── Playwright ────────────────────────────────────────────────────────────────
PLAYWRIGHT_BROWSER=chromium   # chromium | firefox | webkit
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_POOL_SIZE=3

# Overrides harvest_config.json's browser.headless for naukri/linkedin/dice
# harvest runs. Set SHOW_BROWSER=true (with DISPLAY=:99 under Xvfb/x11vnc/noVNC
# on a headless EC2 host) to make Chromium visible over VNC without editing
# harvest_config.json. Leave unset to use the value saved in harvest_config.json.
# SHOW_BROWSER=true

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local         # local | s3
STORAGE_LOCAL_DIR=./data/results
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=harvest-results

# ── Server ────────────────────────────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

