# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=AI Harvest Agent
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-32-chars-min
API_KEY=your-api-key-here    # clients must send X-API-Key: <value>

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# localhost:5432 works when the app runs on the host; inside Docker,
# docker-compose overrides this with host "postgres" automatically.
DATABASE_URL=postgresql+asyncpg://harvest:harvest_password@localhost:5432/harvest_db

# PostgreSQL container credentials — read by docker-compose for the postgres
# service. Keep in sync with DATABASE_URL above.
POSTGRES_DB=harvest_db
POSTGRES_USER=harvest
POSTGRES_PASSWORD=harvest_password
# Host binding for port 5432. 127.0.0.1 (default) keeps the DB reachable from
# the machine itself only — correct for both local dev and EC2 (use an SSH
# tunnel from your laptop for EC2 analysis; never set this to 0.0.0.0 on EC2).
# POSTGRES_BIND_IP=127.0.0.1
# POSTGRES_HOST_PORT=5432

# Source database for scripts/migrate_sqlite_to_postgres.py (read-only source;
# the script never modifies it).
SQLITE_DATABASE_PATH=./data/harvest.db

# Where GET /harvest-status, /run-history, /{linkedin,naukri,dice}-results read
# from: "auto" (DB first, JSON-file fallback if empty/unreachable — default),
# "database" (DB only), or "json" (JSON/file store only, skip the DB read).
# Writes always go to both regardless of this setting.
DATA_SOURCE=auto

# ── Auth / OTP email login ────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN=sightspectrum.com
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── SMTP (login OTPs + harvest report emails — see harvest_config.json "notifications") ───────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@sightspectrum.com
SMTP_USE_TLS=true
# Socket timeout for the whole SMTP exchange, incl. the DATA write. Bump it if
# large emails time out (kept as a safety ceiling).
SMTP_TIMEOUT_SECONDS=60

# ── Outreach ────────────────────────────────────────────────────────────────
# Public URL of the hosted corporate-overview deck. When set, outreach emails
# include a clickable link to it (fast send); when empty, no deck link and no
# attachment. Upload the deck to a public location and paste the share URL here.
OUTREACH_DECK_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=8096

# ── LLM provider (governs ALL LLM usage: HTML extraction AND text/JSON
#    generation — recruiter outreach email/LinkedIn, harvest planning, etc.) ───
# ""/"claude"/"claude-*"          -> Anthropic Claude.
# "ollama"                        -> local Ollama server (LOCAL_LLM_URL), model = LOCAL_LLM_MODEL.
# "openrouter"                    -> OpenRouter, model = OPENROUTER_MODEL.
# "openrouter/<provider>/<model>" -> OpenRouter, using that model id directly.
# any other value (e.g. "llama3.1:8b") -> routed to the local Ollama server instead.
EXTRACTION_LLM_MODEL=claude
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1:8b

# ── OpenRouter (fallback LLM for HTML extraction) ─────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza-your-key-here
GEMINI_MODEL=gemini-2.0-flash

# ── Apollo.io (contact enrichment fallback) ───────────────────────────────────
# Last-resort tier: when the LLM/regex LinkedIn extraction finds no email, look the
# person up on Apollo by their LinkedIn URL. Get the key from the Apollo dashboard →
# Settings → API Keys. Leave APOLLO_API_KEY empty to disable Apollo entirely.
# APOLLO_REVEAL_PHONE: phone reveal is credit-heavy AND delivered asynchronously via
# a webhook, so phones won't resolve synchronously. Apollo REQUIRES APOLLO_WEBHOOK_URL
# when reveal is on — without it the whole request 400s (email included), so phone
# reveal is auto-downgraded to email-only until you set a receiver URL below.
# APOLLO_RECHECK_DAYS: per-profile cooldown so the same person isn't re-sent every run.
APOLLO_API_KEY=
APOLLO_REVEAL_PHONE=false
APOLLO_WEBHOOK_URL=
APOLLO_RECHECK_DAYS=30

# ── LinkedIn Scraper ──────────────────────────────────────────────────────────
# NOTE: No login credentials needed. Users log in manually to Chrome first.
# The agent reuses the persistent Chrome profile at data/chrome_profile/
LINKEDIN_SCRAPER_SLOW_MO_MS=600       # ms between Playwright actions (anti-bot)
LINKEDIN_DESCRIPTION_CONCURRENCY=3   # parallel detail-page tabs
LINKEDIN_HEADLESS=true
# Optional — only used for SSO-based accounts
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
MICROSOFT_EMAIL=
MICROSOFT_PASSWORD=
# Testing-only cap on the number of LinkedIn jobs harvested per run, regardless
# of the max_jobs configured in harvest_config.json. Leave unset/blank to
# harvest normally (no cap beyond max_jobs).
# LINKEDIN_TEST_MAX_JOBS=5

# ── Sales Navigator (standalone experimental script) ──────────────────────────
# Dynamic per-day budget for scripts/scrape_sales_navigator.py — tunable here
# without code changes (NOT derived from MAX_JOBS_PER_DAY). Both UTC-day scoped.
#   SALES_NAVIGATOR_MAX_JOBS_PER_DAY   this script's own per-day cap (0 = disabled/skip)
#   SALES_NAVIGATOR_DAILY_STOP_CEILING stop once today's total scraped jobs reach this (0 = no ceiling)
SALES_NAVIGATOR_MAX_JOBS_PER_DAY=0
SALES_NAVIGATOR_DAILY_STOP_CEILING=0

# ── Naukri Scraper ────────────────────────────────────────────────────────────
# NOTE: No login credentials needed. Users log in manually to Chrome first.
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# ── Dice Scraper ──────────────────────────────────────────────────────────────
# Dice is a public job board — no login required for standard scraping
DICE_EMAIL=
DICE_PASSWORD=

# ── Playwright ────────────────────────────────────────────────────────────────
PLAYWRIGHT_BROWSER=chromium   # chromium | firefox | webkit
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_POOL_SIZE=3

# Overrides harvest_config.json's browser.headless for naukri/linkedin/dice
# harvest runs. Set SHOW_BROWSER=true (with DISPLAY=:99 under Xvfb/x11vnc/noVNC
# on a headless EC2 host) to make Chromium visible over VNC without editing
# harvest_config.json. Leave unset to use the value saved in harvest_config.json.
# SHOW_BROWSER=true

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local         # local | s3
STORAGE_LOCAL_DIR=./data/results
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=harvest-results

# ── Server ────────────────────────────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

