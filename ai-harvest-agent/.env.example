# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=AI Harvest Agent
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-32-chars-min
API_KEY=your-api-key-here
PUBLIC_BASE_URL=

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://harvest:harvest_password@localhost:5432/harvest_db
POSTGRES_DB=harvest_db
POSTGRES_USER=harvest
POSTGRES_PASSWORD=harvest_password
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_HOST_PORT=5432


# ── Auth / OTP email login ────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN=sightspectrum.com
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── SMTP (login OTPs + harvest report emails — see harvest_config.json "notifications") ───────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@sightspectrum.com
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=60

# ── Outreach ────────────────────────────────────────────────────────────────
OUTREACH_DECK_URL=
OUTREACH_AUTO_SEND_ON_HARVEST=true
OUTREACH_AUTO_REPLY_TO=
OUTREACH_EXTRA_REPLY_TO=
OUTREACH_TRACK_ENGAGEMENT=false

# ── Reply forwarding (captured replies → alert mailbox) ──────────────────────
OUTREACH_REPLY_FORWARD_MAP=
OUTREACH_REPLY_FORWARD_DEFAULT=
OUTREACH_REPLY_FORWARD_ROTATION=

# ── Reply tracking (capturing prospect replies to our outreach) ───────────────
REPLY_TRACKING_MODE=brevo

# ── IMAP reply mailbox (used ONLY when REPLY_TRACKING_MODE=imap) ───────────────
# mailbox.
IMAP_HOST=                      # e.g. imap.gmail.com | imappro.zoho.com | outlook.office365.com
IMAP_PORT=993
IMAP_USERNAME=                  # the reply mailbox address, e.g. outreach@sightspectrum.com
IMAP_PASSWORD=
IMAP_USE_SSL=true               
IMAP_MAILBOX=INBOX              
IMAP_POLL_INTERVAL_SECONDS=180  
IMAP_MAX_MESSAGES_PER_POLL=50   

# ── Microsoft Graph reply mailbox (used ONLY when REPLY_TRACKING_MODE=graph) ───
GRAPH_TENANT_ID=                # Entra "Directory (tenant) ID"
GRAPH_CLIENT_ID=                # Entra "Application (client) ID"
GRAPH_CLIENT_SECRET=            # the client secret VALUE from step 2
GRAPH_MAILBOX=                  # the OUTREACH_AUTO_REPLY_TO / Reply-To mailbox to read
GRAPH_MAILBOX_FOLDER=inbox      # folder to read; a dedicated "Replies" folder's id also works
GRAPH_POLL_INTERVAL_SECONDS=180
GRAPH_MAX_MESSAGES_PER_POLL=50

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=8096

# ── LLM provider (governs ALL LLM usage: HTML extraction AND text/JSON
EXTRACTION_LLM_MODEL=claude
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1:8b
EXTRACTION_FALLBACK_MODEL=
REENRICHMENT_MAX_AGE_DAYS=7
REENRICHMENT_SWEEP_LIMIT=50

# ── OpenRouter (fallback LLM for HTML extraction) ─────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza-your-key-here
GEMINI_MODEL=gemini-2.0-flash

# ── Apollo.io (contact enrichment fallback) ───────────────────────────────────
APOLLO_API_KEY=
APOLLO_REVEAL_PHONE=false
APOLLO_WEBHOOK_URL=
APOLLO_WEBHOOK_TOKEN=
APOLLO_PHONE_PENDING_TTL_MINUTES=60
APOLLO_RECHECK_DAYS=30
APOLLO_DAILY_CAP=100
APOLLO_ENRICHMENT_DAILY_CAP=0
APOLLO_MONTHLY_CAP=0

# ── Recruiter Contact Finder (/contacts page) ─────────────────────────────────
RECRUITER_FINDER_DAILY_CAP=50
RECRUITER_FINDER_PHONE_CREDIT_COST=8
RECRUITER_FINDER_MAX_ROWS=1000
RECRUITER_FINDER_CONCURRENCY=3

# ── LinkedIn Scraper ──────────────────────────────────────────────────────────
LINKEDIN_SCRAPER_SLOW_MO_MS=600       # ms between Playwright actions (anti-bot)
LINKEDIN_DESCRIPTION_CONCURRENCY=3   # parallel detail-page tabs
LINKEDIN_HEADLESS=true
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
MICROSOFT_EMAIL=
MICROSOFT_PASSWORD=

# ── LinkedIn profile-visit anti-detection ─────────────────────────────────────
LINKEDIN_PROFILE_VISIT_DELAY_MIN_MS=8000
LINKEDIN_PROFILE_VISIT_DELAY_MAX_MS=25000
LINKEDIN_RECRUITER_VISIT_CAP=25
PROSPECT_INTELLIGENCE_ENABLED=false

# ── LinkedIn Home Feed lead harvest ───────────────────────────────────────────
LINKEDIN_FEED_MAX_POSTS=80              # max posts to inspect, then stop
LINKEDIN_FEED_MAX_SCROLLS=40           # max scroll actions, then stop
LINKEDIN_FEED_SCROLL_DELAY_MS=2500     # pause between scrolls (lets the feed lazy-load)
LINKEDIN_FEED_MIN_SCROLLS=10           # always scroll at least this many times before the no-new stop
LINKEDIN_FEED_NO_NEW_STOP_ROUNDS=3     # stop after N scrolls with no new (non-dup) posts
LINKEDIN_FEED_EMPTY_DOM_STOP_ROUNDS=2  # stop after N scrolls returning an empty feed DOM
LINKEDIN_FEED_LLM_MAX_CALLS=300        # per-run cap on classify+extract LLM calls
LINKEDIN_FEED_MIN_CONFIDENCE=0.6       # min classifier confidence to accept a lead
LINKEDIN_TEST_MAX_JOBS=5

# ── Sales Navigator (standalone experimental script) ──────────────────────────
SALES_NAVIGATOR_MAX_JOBS_PER_DAY=0
SALES_NAVIGATOR_DAILY_STOP_CEILING=0

# ── Naukri Scraper ────────────────────────────────────────────────────────────
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
NAUKRI_BROWSER_MODE=shared
NAUKRI_BROWSER_MODE=recruiter
NAUKRI_RECRUITER_PROFILE_DIR=data/naukri_recruiter_profile
NAUKRI_RECRUITER_LOGIN_MODE=auto
NAUKRI_LAUNCHER_APPIMAGE=data/naukri_launcher/naukri-launcher.AppImage

# ── Resdex candidate matching ────────────────────────────────────────────────
RESDEX_ENABLED=false
RESDEX_INCLUDE_IN_EMAIL=false
RESDEX_EMAIL_MODE=count
RESDEX_EMAIL_MIN_COUNT=3
RESDEX_EMAIL_MAX_COUNT=60
RESDEX_SHOW_NAUKRI_VERIFIED=true
RESDEX_SOURCES=LinkedIn,Naukri
RESDEX_INCLUDE_COMPANY_CONTACTS=false
RESDEX_INCLUDE_JOBS_WITHOUT_EMAIL=false
RESDEX_INCLUDE_APOLLO_CONTACTS=true
RESDEX_APOLLO_SWEEP_MAX_JOBS=10
RESDEX_APOLLO_SWEEP_LOOKBACK_DAYS=7
RESDEX_CANDIDATES_PER_JOB=3
RESDEX_MIN_SKILL_COVERAGE=0.6
RESDEX_ACTIVE_WITHIN_MONTHS=3
RESDEX_ACTIVE_IN=15 days
RESDEX_MAX_SEARCHES_PER_JOB=3
RESDEX_SEARCH_TIER=0
RESDEX_OPEN_PROFILES=false
RESDEX_DAILY_SEARCH_CAP=100
RESDEX_DAILY_CANDIDATE_CAP=100
RESDEX_REUSE_DAYS=14
RESDEX_DELAY_MIN_MS=20000
RESDEX_DELAY_MAX_MS=45000
RESDEX_RESULTS_DWELL_MIN_S=5
RESDEX_RESULTS_DWELL_MAX_S=15
RESDEX_BREAK_EVERY_SEARCHES=10
RESDEX_BREAK_MIN_S=120
RESDEX_BREAK_MAX_S=240
RESDEX_HUMAN_WAIT_S=600
RESDEX_LLM_TIMEOUT_S=45
NAUKRI_FETCH_DETAILS=true
NAUKRI_DETAIL_DELAY_MIN_MS=30000
NAUKRI_DETAIL_DELAY_MAX_MS=60000
NAUKRI_BACKOFF_MAX_MULTIPLIER=4.0
NAUKRI_BACKOFF_CLEAN_STREAK=10
NAUKRI_BREAK_EVERY_DETAILS=18
NAUKRI_BREAK_MIN_S=180
NAUKRI_BREAK_MAX_S=300
NAUKRI_BLOCK_COOLDOWN_MIN_S=120
NAUKRI_BLOCK_COOLDOWN_MAX_S=300
NAUKRI_BREAKER_THRESHOLD=3
NAUKRI_BREAKER_PAUSE_MIN_S=600
NAUKRI_BREAKER_PAUSE_MAX_S=900
NAUKRI_HUMAN_WAIT_S=600
NAUKRI_LLM_CONTACT_EXTRACTION=true
NAUKRI_LLM_DESCRIPTION_RESTRUCTURE=true
NAUKRI_LLM_TIMEOUT_S=45
NAUKRI_LLM_CONCURRENCY=2
NAUKRI_LLM_MAX_CALLS_PER_RUN=1000
NAUKRI_TEST_MAX_JOBS=5

# ── Dice Scraper ──────────────────────────────────────────────────────────────
# Dice is a public job board — no login required for standard scraping
DICE_EMAIL=
DICE_PASSWORD=

# ── Playwright ────────────────────────────────────────────────────────────────
PLAYWRIGHT_BROWSER=chromium   # chromium | firefox | webkit
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_POOL_SIZE=3

# Overrides harvest_config.json's browser.headless for naukri/linkedin/dice
# harvest runs. Set SHOW_BROWSER=true (with DISPLAY=:99 under Xvfb/x11vnc/noVNC
# on a headless EC2 host) to make Chromium visible over VNC without editing
# harvest_config.json. Leave unset to use the value saved in harvest_config.json.
# SHOW_BROWSER=true

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

