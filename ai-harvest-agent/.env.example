# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=AI Harvest Agent
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-32-chars-min
API_KEY=your-api-key-here    # clients must send X-API-Key: <value>

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/harvest_db
# For local dev without Postgres (path under ./data so it survives container
# rebuilds — docker-compose mounts ./data as a volume at /app/data):
# DATABASE_URL=sqlite+aiosqlite:///./data/harvest.db

# Where GET /harvest-status, /run-history, /{linkedin,naukri,dice}-results read
# from: "auto" (DB first, JSON-file fallback if empty/unreachable — default),
# "database" (DB only), or "json" (JSON/file store only, skip the DB read).
# Writes always go to both regardless of this setting.
DATA_SOURCE=auto

# ── Auth / OTP email login ────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN=sightspectrum.com
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── SMTP (login OTPs + harvest report emails — see harvest_config.json "notifications") ───────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@sightspectrum.com
SMTP_USE_TLS=true

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=8096

# ── HTML extraction LLM provider (used by LLMService.extract_json) ───────────
# ""/"claude"/"claude-*" -> Anthropic Claude. Any other value (e.g. "llama3.1:8b",
# or the literal "ollama") -> routed to the local Ollama server instead.
EXTRACTION_LLM_MODEL=claude
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1:8b

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza-your-key-here
GEMINI_MODEL=gemini-2.0-flash

# ── LinkedIn Scraper ──────────────────────────────────────────────────────────
# NOTE: No login credentials needed. Users log in manually to Chrome first.
# The agent reuses the persistent Chrome profile at data/chrome_profile/
LINKEDIN_SCRAPER_SLOW_MO_MS=600       # ms between Playwright actions (anti-bot)
LINKEDIN_DESCRIPTION_CONCURRENCY=3   # parallel detail-page tabs
LINKEDIN_HEADLESS=true
# Optional — only used for SSO-based accounts
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
MICROSOFT_EMAIL=
MICROSOFT_PASSWORD=
# Testing-only cap on the number of LinkedIn jobs harvested per run, regardless
# of the max_jobs configured in harvest_config.json. Leave unset/blank to
# harvest normally (no cap beyond max_jobs).
# LINKEDIN_TEST_MAX_JOBS=5

# ── Naukri Scraper ────────────────────────────────────────────────────────────
# NOTE: No login credentials needed. Users log in manually to Chrome first.
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# ── Dice Scraper ──────────────────────────────────────────────────────────────
# Dice is a public job board — no login required for standard scraping
DICE_EMAIL=
DICE_PASSWORD=

# ── Playwright ────────────────────────────────────────────────────────────────
PLAYWRIGHT_BROWSER=chromium   # chromium | firefox | webkit
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_POOL_SIZE=3

# Overrides harvest_config.json's browser.headless for naukri/linkedin/dice
# harvest runs. Set SHOW_BROWSER=true (with DISPLAY=:99 under Xvfb/x11vnc/noVNC
# on a headless EC2 host) to make Chromium visible over VNC without editing
# harvest_config.json. Leave unset to use the value saved in harvest_config.json.
# SHOW_BROWSER=true

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local         # local | s3
STORAGE_LOCAL_DIR=./data/results
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=harvest-results

# ── Server ────────────────────────────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
