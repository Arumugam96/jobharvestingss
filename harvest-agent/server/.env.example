# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/harvest_agent

# Comma-separated job keywords to search across all sources
KEYWORDS=react developer,java developer,devops engineer,python developer,data engineer

# Max jobs to harvest per keyword per source (e.g. 20 = up to 20 from Naukri + 20 from Dice + 20 from LinkedIn)
MAX_JOBS_PER_SOURCE=20
